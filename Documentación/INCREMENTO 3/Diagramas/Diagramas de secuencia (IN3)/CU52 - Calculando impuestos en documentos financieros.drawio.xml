        <mxCell id="jDScHVKaE87Ov8xIz7k4-17" value='&lt;b&gt;Excepción 1: IVA no configurado&lt;/b&gt;&lt;br&gt;Si el IVA no está configurado, el documento se calcula con 0%, se muestra "El&lt;br&gt;IVA no está configurado: el documento se calculó con 0%" y queda una alerta en&lt;br&gt;el log de auditoría.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="684" y="806" width="474" height="78" as="geometry"/></mxCell>
