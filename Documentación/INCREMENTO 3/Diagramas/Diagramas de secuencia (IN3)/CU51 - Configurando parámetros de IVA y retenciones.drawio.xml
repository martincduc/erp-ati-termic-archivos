        <mxCell id="YDojqYZdrK11PJiB8Nx--11" value='&lt;b&gt;Campos vacíos&lt;/b&gt;&lt;br&gt;Si falta un porcentaje, el sistema responde "Completa los porcentajes de IVA y&lt;br&gt;retención".' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="838" y="522" width="474" height="62" as="geometry"/></mxCell>
        <mxCell id="YDojqYZdrK11PJiB8Nx--12" value='&lt;b&gt;Excepción 1: valor no numérico&lt;/b&gt;&lt;br&gt;Si un valor no es un número responde "El valor ingresado no es numérico.&lt;br&gt;Ingresa un número válido".' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="838" y="600" width="440" height="62" as="geometry"/></mxCell>
