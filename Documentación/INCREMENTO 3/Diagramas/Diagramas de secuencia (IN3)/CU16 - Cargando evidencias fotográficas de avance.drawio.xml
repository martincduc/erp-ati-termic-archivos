        <mxCell id="pH_avHsHEwFF9JZLY1T2-1" value='1. Ingresa a "Evidencias" y selecciona proyecto e hito' style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="180" as="sourcePoint"/><mxPoint x="487" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="pH_avHsHEwFF9JZLY1T2-2" value="&lt;b&gt;Proceso interno&lt;/b&gt;&lt;br&gt;Solicitar acceso a la cámara y a la ubicación" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="198" width="286" height="46" as="geometry"/></mxCell>
        <mxCell id="pH_avHsHEwFF9JZLY1T2-3" value='&lt;b&gt;Excepción 1: permiso denegado&lt;/b&gt;&lt;br&gt;Si no hay acceso a la cámara, la vista muestra "No se pudo acceder a la&lt;br&gt;cámara. Verifica los permisos del navegador."' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="260" width="434" height="62" as="geometry"/></mxCell>
        <mxCell id="pH_avHsHEwFF9JZLY1T2-4" value="2. Mostrar cámara y vista previa" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="487" y="356" as="sourcePoint"/><mxPoint x="135" y="356" as="targetPoint"/></mxGeometry></mxCell>
