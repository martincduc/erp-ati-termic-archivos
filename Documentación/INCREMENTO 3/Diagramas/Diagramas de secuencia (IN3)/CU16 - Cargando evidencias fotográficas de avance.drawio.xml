        <mxCell id="pH_avHsHEwFF9JZLY1T2-7" value="&lt;b&gt;Excepción 2: fallo de carga&lt;/b&gt;&lt;br&gt;Si el envío falla por conexión, la vista deja la foto en una cola local y la&lt;br&gt;sube cuando vuelve la señal." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="446" width="463" height="62" as="geometry"/></mxCell>
