        <mxCell id="JRDYsib3kM2gikBl2soK-28" value='&lt;b&gt;Excepción 3: artículo fuera del catálogo&lt;/b&gt;&lt;br&gt;Si el artículo ya no existe, el sistema responde "Uno de los artículos&lt;br&gt;seleccionados ya no existe en el catálogo" y cancela la operación.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="873" y="1260" width="429" height="62" as="geometry"/></mxCell>
        <mxCell id="JRDYsib3kM2gikBl2soK-29" value='&lt;b&gt;Excepción 4: stock insuficiente&lt;/b&gt;&lt;br&gt;Si la cantidad supera el stock, el sistema responde "No hay unidades&lt;br&gt;suficientes" indicando cuántas quedan disponibles, y no registra ninguna&lt;br&gt;entrega del lote.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="873" y="1338" width="440" height="78" as="geometry"/></mxCell>
