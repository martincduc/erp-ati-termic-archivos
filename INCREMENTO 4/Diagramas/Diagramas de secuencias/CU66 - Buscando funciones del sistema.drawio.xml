        <mxCell id="wSYogn2wCon9geq3Bt4w-16" value="&lt;b&gt;Alcance del caso de uso&lt;/b&gt;&lt;br&gt;El buscador funciona completo en el navegador: usa el rol guardado al iniciar&lt;br&gt;sesión y no consulta al servidor ni a la base de datos." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="625" y="162" width="468" height="62" as="geometry"/></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-17" value="1. Presiona &quot;Buscar función...&quot; en la barra superior o las teclas Ctrl + K" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="258" as="sourcePoint"/><mxPoint x="602" y="258" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-18" value="&lt;b&gt;Proceso interno&lt;/b&gt;&lt;br&gt;Tomar las funciones permitidas para el rol del actor. El Supervisor de Obra no&lt;br&gt;recibe las funciones exclusivas del Administrador Total." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="625" y="276" width="474" height="62" as="geometry"/></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-19" value="2. Abrir el buscador con las funciones del rol" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="612" y="372" as="sourcePoint"/><mxPoint x="913" y="372" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-20" value="3. Mostrar todas las funciones permitidas con su módulo" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="913" y="408" as="sourcePoint"/><mxPoint x="135" y="408" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-21" value="4. Escribe parte del nombre de la función o del módulo" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="444" as="sourcePoint"/><mxPoint x="913" y="444" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-22" value="&lt;b&gt;Proceso interno&lt;/b&gt;&lt;br&gt;Filtrar la lista a medida que se escribe, sin distinguir mayúsculas ni tildes." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="936" y="462" width="474" height="46" as="geometry"/></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-23" value="5. Mostrar las funciones que coinciden junto a su módulo" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="913" y="542" as="sourcePoint"/><mxPoint x="135" y="542" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-24" value="&lt;b&gt;Excepción 1: sin resultados&lt;/b&gt;&lt;br&gt;Si ninguna función coincide, el buscador muestra &quot;Sin resultados para&quot; junto&lt;br&gt;al texto buscado." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="936" y="560" width="463" height="62" as="geometry"/></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-25" value="6. Recorre los resultados con las flechas o el mouse y elige con Enter o clic" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="656" as="sourcePoint"/><mxPoint x="913" y="656" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-26" value="7. Cerrar el buscador y abrir la función elegida" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="923" y="692" as="sourcePoint"/><mxPoint x="1236" y="692" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="wSYogn2wCon9geq3Bt4w-27" value="8. Mostrar la función elegida" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;strokeColor=#000000;fontColor=#000000;endArrow=open;endFill=0;dashed=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1236" y="728" as="sourcePoint"/><mxPoint x="135" y="728" as="targetPoint"/></mxGeometry></mxCell>
